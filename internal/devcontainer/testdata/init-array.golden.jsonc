{
    "image": "node:22",
    "initializeCommand": {
        "init": ["sh", "-c", "touch .env"],
        "berthlight": ["berthlight", "add", "--project", "shop", "--target", "bl-${localWorkspaceFolderBasename}", "--network", "bl-${localWorkspaceFolderBasename}", "-C", "${localWorkspaceFolder}", "8080"]
    },
    "runArgs": ["--network=bl-${localWorkspaceFolderBasename}", "--network-alias=bl-${localWorkspaceFolderBasename}"]
}
