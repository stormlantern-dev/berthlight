{
  "name": "api",
  "dockerComposeFile": [
    "../compose.yml",
    // Ports and volumes for development.
    "compose.dev.yml",
    "berthlight.compose.yml",
  ],
  "service": "app",
  "initializeCommand": {
    "env": "touch .env",
    "berthlight": ["berthlight", "add", "--project", "shop", "--target", "bl-${localWorkspaceFolderBasename}", "--network", "bl-${localWorkspaceFolderBasename}", "--compose-service", "app", "--compose-override", ".devcontainer/berthlight.compose.yml", "-C", "${localWorkspaceFolder}", "8080"],
  },
  "forwardPorts": [5432],
}
