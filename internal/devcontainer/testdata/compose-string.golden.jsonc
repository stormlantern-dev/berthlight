// The app with its database, from Compose.
{
  "name": "api",
  "dockerComposeFile": ["compose.yml", "berthlight.compose.yml"], // app and db
  "service": "app",
  "workspaceFolder": "/workspace",
  "initializeCommand": ["berthlight", "add", "--project", "shop", "--target", "bl-${localWorkspaceFolderBasename}", "--network", "bl-${localWorkspaceFolderBasename}", "--compose-service", "app", "--compose-override", ".devcontainer/berthlight.compose.yml", "-C", "${localWorkspaceFolder}", "8080"],
}
